rules_version = '2';
// TripApp — Firestore security rules.
// Paste into Firebase console: Build > Firestore Database > Rules > Publish.
//
// Access requires anonymous (or any) sign-in. Data lives under a per-couple
// document keyed by your secret couple code, so only devices that know the
// code touch your data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{coupleCode} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
